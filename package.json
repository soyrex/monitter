{
  "name": "monitter",
  "version": "0.1.0",
  "description": "Your agents, together. Native local and SSH agent workspace.",
  "type": "module",
  "scripts": {
    "build:share": "vite build --config share-web/vite.config.mjs",
    "dev": "vite dev",
    "dev:web": "vite dev --mode monitter-web",
    "dev:app-ui": "MONITTER_APP_UI=1 vite dev --mode monitter-app-ui",
    "build": "vite build && node scripts/publish-lan-web.mjs",
    "publish:lan": "node scripts/publish-lan-web.mjs",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "build:mac": "node scripts/build-macos.mjs",
    "install:mac": "node scripts/install-macos.mjs",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:hot-ui": "node scripts/hot-ui-test.mjs",
    "test:extensions:ui": "node scripts/extensions-settings-ui-test.mjs",
    "test:workspaces": "node scripts/workspace-persistence-test.mjs",
    "test:workspaces:ui": "node scripts/ui-scoped-workspaces-smoke.mjs",
    "test:overview:ui": "node scripts/ui-global-overview-workspace-smoke.mjs",
    "test:usage-rings": "node scripts/usage-rings-time-test.mjs",
    "test:codex-accounts:ui": "node scripts/codex-accounts-ui-test.mjs",
    "test:native": "node scripts/native-smoke.mjs",
    "test:permissions": "node scripts/permission-contract-test.mjs",
    "build:mac:local": "node scripts/build-macos.mjs --debug",
    "test:hermes-bridge": "python3 scripts/test-hermes-bridge.py",
    "test:controller": "node scripts/controller-protocol-test.mjs",
    "test:remote": "node scripts/secure-transport-run.mjs",
    "relay": "node scripts/relay-server.mjs",
    "build:ios:web": "sh mobile-ios/build.sh",
    "test:mobile": "node scripts/mobile-ui-test.mjs",
    "package:relay": "node scripts/package-relay.mjs",
    "test:android-bundle": "node scripts/android-bundle-test.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@lobehub/icons-static-svg": "^1.95.0",
    "@lucide/svelte": "^1.43.0",
    "@tanstack/svelte-virtual": "3.13.39",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "^3.4.15",
    "marked": "^18.0.12",
    "qrcode": "^1.5.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
